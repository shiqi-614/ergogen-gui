{
  "name": "ergogen-gui",
  "version": "0.2.0",
  "homepage": "https://ergogen.cache.works/",
  "private": false,
  "type": "module",
  "dependencies": {
    "@monaco-editor/react": "4.2.2",
    "@svgdotjs/svg.js": "^3.1.1",
    "@types/node": "^16.9.4",
    "@types/react": "^17.0.21",
    "@types/react-dom": "^17.0.9",
    "@types/three": "0.149.0",
    "ergogen": "github:shiqi-614/ergogen#develop",
    "js-yaml": "^4.1.0",
    "lodash.debounce": "^4.0.8",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-easy-panzoom": "^0.4.4",
    "react-select": "^5.2.1",
    "react-split": "^2.0.14",
    "react-use": "^17.3.2",
    "styled-components": "^5.3.1",
    "three": "0.149.0",
    "three-dxf": "^1.0.1",
    "typescript": "^5.9.3",
    "web-vitals": "^1.0.1",
    "yaml": "^1.10.0",
    "yaml-js": "^0.2.3"
  },
  "scripts": {
    "build-ergogen": "cd node_modules/ergogen && yarn install && yarn run build && cp dist/ergogen.js ../../public/dependencies/ergogen.js",
    "postinstall": "yarn upgrade ergogen && yarn run build-ergogen",
    "start": "vite",
    "build": "tsc && vite build",
    "postbuild": "yarn run build-ergogen",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "predeploy": "yarn run build",
    "deploy": "gh-pages -d build"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.3",
    "@types/lodash-es": "^4.17.5",
    "@types/lodash.debounce": "^4.0.6",
    "@types/styled-components": "^5.1.14",
    "@typescript-eslint/eslint-plugin": "^4.0.0",
    "@typescript-eslint/parser": "^4.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-eslint": "^10.0.0",
    "eslint": "^7.5.0",
    "eslint-config-react-app": "^6.0.0",
    "eslint-plugin-flowtype": "^5.2.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-react": "^7.20.3",
    "eslint-plugin-react-hooks": "^4.0.8",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
